\bookpart {
    \header {
        title = "Double Approach Note Exercises for Saxophone"
        subtitle = "Scale patterns with double approach notes"
    }

    \score {
        \header {
            title = ""
            subtitle = ""
            piece = "      C Major - Descending+Ascending chromatic notes"
            composer = ""
        } 
        << 
            \new ChordNames \transpose c c { 
               \approachNoteChords 
            }
            \new Staff {
                \include "ly/ily/staff-properties.ily"
                \transpose c c \scaleDoubleChromaticDescendingAscendingOne
            }
        >>
    }
